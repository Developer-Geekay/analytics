# ==========================================
# ANALYTICS ENGINE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Environment Mode ('development' | 'staging' | 'production')
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud)
# Local Example: mongodb://127.0.0.1:27017/analytics_db
# Atlas Example: mongodb+srv://username:password@cluster0.mongodb.net/analytics_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/analytics_db

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTH_SECRET=analytics_secure_hmac_secret_key_change_in_production

# CORS Allowed Origins (default: '*' for all domains or 'https://yourdomain.com')
CORS_ORIGIN=*
